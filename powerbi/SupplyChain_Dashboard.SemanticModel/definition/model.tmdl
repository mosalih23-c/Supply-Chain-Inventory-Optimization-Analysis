model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["FolderPath","Products","Suppliers","Stores","DimDate","Sales","Inventory","PurchaseOrders","Deliveries"]

ref table Products
ref table Suppliers
ref table Stores
ref table DimDate
ref table Sales
ref table Inventory
ref table PurchaseOrders
ref table Deliveries

ref cultureInfo en-US

