table Inventory
	lineageTag: 941e350d-4bf3-2f61-c9e2-cc823b85b52a

	measure 'Total Inventory Units' = SUM(Inventory[OnHandUnits])
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 78f4e39b-d983-2e15-633f-ebbea6418ddf

	measure 'Total On-Hand Units' = [Total Inventory Units]
		formatString: #,0
		displayFolder: Inventory
		lineageTag: d5a60fc4-9cca-0948-4f20-3860b17b9575

	measure 'Available Inventory Units' = SUM(Inventory[AvailableUnits])
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 7122f642-1f16-380c-16a3-48d7b6c1f116

	measure 'Total Available Units' = [Available Inventory Units]
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 2b927b1f-d8e2-1f0a-9948-2087b7d70d71

	measure 'Excess Inventory Units' = CALCULATE(SUM(Inventory[ExcessUnits]), KEEPFILTERS(Inventory[StockStatus] = "Excess"))
		formatString: #,0
		displayFolder: Inventory
		lineageTag: e4c2eeac-c8de-3f55-7ab4-86ff9d904bb8

	measure 'Excess Inventory Value' = CALCULATE(SUM(Inventory[ExcessValue]), KEEPFILTERS(Inventory[StockStatus] = "Excess"))
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 4c474e11-3821-7af3-2715-e9267c362a04

	measure 'Inventory Value' = SUM(Inventory[InventoryValue])
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 3b5c94fa-0919-ba66-f912-d32e7e6d131c

	measure 'Excess Value %' = DIVIDE([Excess Inventory Value], [Inventory Value])
		formatString: 0.0%
		displayFolder: Inventory
		lineageTag: 4b8aa43f-d637-44a6-4190-57c5457207b0

	measure 'Inventory Records' = COUNTROWS(Inventory)
		formatString: #,0
		displayFolder: Inventory
		lineageTag: b7992bb0-b999-38c4-d0d8-b9c028e5870e

	measure 'Stockout Records' = CALCULATE(COUNTROWS(Inventory), KEEPFILTERS(Inventory[StockStatus] = "Out of Stock")) + 0
		formatString: #,0
		displayFolder: Stock Risk
		lineageTag: ee3c8833-a0b4-0922-1500-0ad808bbaa20

	measure 'Records Requiring Reorder' = CALCULATE(COUNTROWS(Inventory), KEEPFILTERS(Inventory[StockStatus] IN {"Reorder Now", "Out of Stock"})) + 0
		formatString: #,0
		displayFolder: Stock Risk
		lineageTag: 3bd5262a-8d38-570e-f749-69c601bf4a76

	measure 'Excess Records' = CALCULATE(COUNTROWS(Inventory), KEEPFILTERS(Inventory[StockStatus] = "Excess")) + 0
		formatString: #,0
		displayFolder: Stock Risk
		lineageTag: 15d21b10-96a8-923e-bb5a-e965f131fbd6

	measure 'Stores With Excess' = CALCULATE(DISTINCTCOUNT(Inventory[StoreID]), KEEPFILTERS(Inventory[StockStatus] = "Excess"))
		formatString: #,0
		displayFolder: Allocation
		lineageTag: 51832ae4-ef27-d2ea-8801-d3f752859606

	measure 'Stores Needing Stock' = CALCULATE(DISTINCTCOUNT(Inventory[StoreID]), KEEPFILTERS(Inventory[StockStatus] IN {"Reorder Now", "Out of Stock"}))
		formatString: #,0
		displayFolder: Allocation
		lineageTag: ded2499f-8a0d-1a34-1c1c-585c631e00ff

	measure 'Shortage Units' = SUMX(FILTER(Inventory, Inventory[StockStatus] IN {"Reorder Now", "Out of Stock"}), MAX(MAX(Inventory[ReorderPointUnits], Inventory[TargetStockUnits]) - Inventory[AvailableUnits], 0))
		formatString: #,0
		displayFolder: Allocation
		lineageTag: e77b34b5-95d5-0ed8-60ed-f05f0c3551d6

	measure 'Transfer Potential Units' = VAR ex = [Excess Inventory Units] VAR sh = [Shortage Units] RETURN IF(ex > 0 && sh > 0, MIN(ex, sh))
		formatString: #,0
		displayFolder: Allocation
		lineageTag: 92395f93-3150-7f51-3d6f-6f1f9dce759f

	measure 'Alloc Stores With Excess' = IF(NOT ISBLANK([Transfer Potential Units]), [Stores With Excess])
		formatString: #,0
		displayFolder: Allocation
		lineageTag: ac1549aa-093a-307d-9828-60ce97c49d25

	measure 'Alloc Stores Needing Stock' = IF(NOT ISBLANK([Transfer Potential Units]), [Stores Needing Stock])
		formatString: #,0
		displayFolder: Allocation
		lineageTag: a18dc06c-73f1-10d0-1805-b6e7eb736ccf

	measure 'Alloc Excess Units' = IF(NOT ISBLANK([Transfer Potential Units]), [Excess Inventory Units])
		formatString: #,0
		displayFolder: Allocation
		lineageTag: 9173bcf5-5e4c-c243-9fed-5ba0840fde46

	measure 'Alloc Shortage Units' = IF(NOT ISBLANK([Transfer Potential Units]), [Shortage Units])
		formatString: #,0
		displayFolder: Allocation
		lineageTag: 22cb8f96-719a-1278-1600-bb31cfbc8c56

	measure 'Status Color' = SWITCH(SELECTEDVALUE(Inventory[StockStatus]), "Out of Stock", "#C84D4D", "Reorder Now", "#E5A33D", "Healthy", "#25856A", "Excess", "#2878A0", "#16324F")
		displayFolder: Formatting
		lineageTag: 01137e21-a80a-952f-cc5b-54ba30642af6

