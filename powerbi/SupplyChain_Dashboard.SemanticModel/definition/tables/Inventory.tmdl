	partition Inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderPath & "inventory_snapshot_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"StoreID", type text}, {"ProductID", type text}, {"Category", type text}, {"SupplierID", type text}, {"SnapshotDate", type date}, {"OnHandUnits", Int64.Type}, {"ReservedUnits", Int64.Type}, {"DamagedUnits", Int64.Type}, {"UnusableUnits", Int64.Type}, {"AvailableUnits", Int64.Type}, {"UnusableExceedsOnHand", type text}, {"UnitCost", type number}, {"InventoryValue", type number}, {"AvailableValue", type number}, {"DamagedValue", type number}, {"AvgDailySales", type number}, {"StdDevDailySales", type number}, {"LeadTimeDays", Int64.Type}, {"TargetStockDays", Int64.Type}, {"MinOrderQty", Int64.Type}, {"DaysOfCover", type number}, {"SafetyStockUnits", Int64.Type}, {"ReorderPointUnits", Int64.Type}, {"TargetStockUnits", Int64.Type}, {"ExcessUnits", Int64.Type}, {"ExcessValue", type number}, {"StockStatus", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

