table PurchaseOrders
	lineageTag: d46eee92-1f99-6126-1002-61b4945a7dc3

	measure 'Total Purchase Orders' = COUNTROWS(PurchaseOrders)
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 82a4ce85-786f-02e8-4089-0490ec862e2a

	measure 'Total Ordered Units' = SUM(PurchaseOrders[OrderQty])
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: eb0fe5b5-ec0d-e150-1c57-461878214d9d

	measure 'Total Received Units' = SUM(PurchaseOrders[ReceivedQty])
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 9e826a48-6738-f4c1-5142-3e8c3a324da1

	measure 'Outstanding Units' = SUM(PurchaseOrders[PendingQty]) + 0
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 18377e4b-be79-3400-515c-7ee7b772de9d

	measure 'Outstanding Units (Open POs)' = CALCULATE(SUM(PurchaseOrders[PendingQty]), KEEPFILTERS(PurchaseOrders[PendingQty] > 0))
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 6b900404-cfd1-2a7e-8f4a-013352f253cb

	measure 'Fulfillment Rate %' = DIVIDE([Total Received Units], [Total Ordered Units])
		formatString: 0.0%
		displayFolder: Purchase Orders
		lineageTag: d22268ae-5c8b-efde-32fe-6fc8edd82f75

	measure 'Open POs' = CALCULATE(COUNTROWS(PurchaseOrders), KEEPFILTERS(PurchaseOrders[StatusClean] <> "Received"))
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 7864bda2-9765-630c-45e0-498994e89526

	measure 'Overdue POs' = CALCULATE(COUNTROWS(PurchaseOrders), KEEPFILTERS(PurchaseOrders[DeliveryStatus] = "Open - Overdue"))
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 889fb668-c776-d502-465e-178346c058a5

	measure 'Open POs Not Yet Due' = CALCULATE(COUNTROWS(PurchaseOrders), KEEPFILTERS(PurchaseOrders[DeliveryStatus] = "Open - Not Yet Due"))
		formatString: #,0
		displayFolder: Purchase Orders
		lineageTag: 10430baa-8f77-02af-e7f8-9eedad775aef

	measure 'PO Status Color' = SWITCH(SELECTEDVALUE(PurchaseOrders[DeliveryStatus]), "Late", "#C84D4D", "Open - Overdue", "#C84D4D", "Open - Not Yet Due", "#E5A33D", "Early", "#25856A", "On Time", "#25856A", "#16324F")
		displayFolder: Formatting
		lineageTag: 3ee3610a-2b4c-0c2a-2cda-db3e32f5dd12

