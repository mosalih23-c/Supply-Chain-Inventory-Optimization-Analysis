	partition PurchaseOrders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderPath & "purchase_orders_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"POID", type text}, {"ProductID", type text}, {"SupplierID", type text}, {"OrderDate", type date}, {"ExpectedDeliveryDate", type date}, {"ActualDeliveryDate", type date}, {"OrderQty", Int64.Type}, {"ReceivedQty", Int64.Type}, {"OrderValue", type number}, {"Status", type text}, {"PendingQty", Int64.Type}, {"FillRatePct", type number}, {"ReceivedValue", type number}, {"PlannedLeadTimeDays", Int64.Type}, {"ActualLeadTimeDays", Int64.Type}, {"DeliveryDelayDays", Int64.Type}, {"StatusClean", type text}, {"DeliveryStatus", type text}, {"DataIssue", type text}, {"HasDataIssue", type text}}, "en-US"),
				    Result = Table.AddColumn(Typed, "POStatus", each if [StatusClean] = "Received" then "Received" else if Text.Contains([StatusClean], "Partially") then "Partially Received" else "Received - Not Closed", type text)
				in
				    Result

	annotation PBI_ResultType = Table

