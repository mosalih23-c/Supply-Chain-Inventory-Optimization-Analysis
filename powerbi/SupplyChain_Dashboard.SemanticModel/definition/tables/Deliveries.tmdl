		summarizeBy: none
		sourceColumn: ActualLeadTimeDays

		annotation SummarizationSetBy = Automatic

	column ExpectedLeadTimeDays
		dataType: int64
		lineageTag: 89f3e1b0-a164-08e2-d989-005c59bfd79b
		summarizeBy: none
		sourceColumn: ExpectedLeadTimeDays

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: string
		lineageTag: 15f91b16-abd6-f1fe-ebd3-1c18c1b1dec7
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	partition Deliveries = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderPath & "supplier_delivery_performance_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"POID", type text}, {"SupplierID", type text}, {"OrderDate", type date}, {"ExpectedDeliveryDate", type date}, {"ActualDeliveryDate", type date}, {"DeliveryDelayDays", Int64.Type}, {"OrderQty", Int64.Type}, {"ReceivedQty", Int64.Type}, {"DelayMatchesDates", type text}, {"DeliveryStatus", type text}, {"LateDays", Int64.Type}, {"ActualLeadTimeDays", Int64.Type}}, "en-US"),
				    AddExpected = Table.AddColumn(Typed, "ExpectedLeadTimeDays", each Duration.Days([ExpectedDeliveryDate] - [OrderDate]), Int64.Type),
				    POSource = Table.PromoteHeaders(Csv.Document(File.Contents(FolderPath & "purchase_orders_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    POMap = Table.SelectColumns(POSource, {"POID", "ProductID"}),
				    Joined = Table.NestedJoin(AddExpected, {"POID"}, POMap, {"POID"}, "PO", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "PO", {"ProductID"}, {"ProductID"}),
				    Result = Table.TransformColumnTypes(Expanded, {{"ProductID", type text}})
				in
				    Result

	annotation PBI_ResultType = Table

