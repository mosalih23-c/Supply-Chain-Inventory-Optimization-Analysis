	column DeliveryStatus
		dataType: string
		lineageTag: 2e29673f-7f78-2cbf-f969-26a89d23d9c1
		summarizeBy: none
		sourceColumn: DeliveryStatus

		annotation SummarizationSetBy = Automatic

	column LateDays
		dataType: int64
		lineageTag: 3bf8c825-1ed1-cded-8c08-cb76e0bcdd4e
		summarizeBy: none
		sourceColumn: LateDays

