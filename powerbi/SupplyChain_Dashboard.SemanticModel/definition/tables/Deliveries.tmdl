table Deliveries
	lineageTag: caff68fd-740e-f2ec-41f0-3db4eb893aa2

	measure 'Total Deliveries' = COUNTROWS(Deliveries)
		formatString: #,0
		displayFolder: Suppliers
		lineageTag: 91014003-0602-6639-2a04-bb4516568fbf

	measure 'Late Deliveries' = VAR n = CALCULATE(COUNTROWS(Deliveries), KEEPFILTERS(Deliveries[DeliveryStatus] = "Late")) RETURN IF(ISBLANK(n) && NOT ISBLANK([Total Deliveries]), 0, n)
		formatString: #,0
		displayFolder: Suppliers
		lineageTag: 1372144a-57ff-9f68-0f84-91dc5696b006

	measure 'On-Time Deliveries' = VAR n = CALCULATE(COUNTROWS(Deliveries), KEEPFILTERS(Deliveries[DeliveryStatus] IN {"On Time", "Early"})) RETURN IF(ISBLANK(n) && NOT ISBLANK([Total Deliveries]), 0, n)
		formatString: #,0
		displayFolder: Suppliers
		lineageTag: 0efff35d-0eb4-d07a-3196-4095d595bc26

	measure 'Late Delivery %' = DIVIDE([Late Deliveries], [Total Deliveries])
		formatString: 0.0%
		displayFolder: Suppliers
		lineageTag: 45f67059-d102-e06e-7dbb-abc3f268d34c

	measure 'Total Suppliers' = DISTINCTCOUNT(Deliveries[SupplierID])
		formatString: #,0
		displayFolder: Suppliers
		lineageTag: 47e32b65-1039-0330-cbf7-0e2a7e04ba92

	measure 'Avg Actual Lead Time' = AVERAGE(Deliveries[ActualLeadTimeDays])
		formatString: 0.0
		displayFolder: Suppliers
		lineageTag: 6f22aeb2-3458-0acd-36b9-8167d404e34e

	measure 'Avg Expected Lead Time' = AVERAGE(Deliveries[ExpectedLeadTimeDays])
		formatString: 0.0
		displayFolder: Suppliers
		lineageTag: 98d220e8-118a-8314-e95b-c1a904e79775

	measure 'Avg Late Days' = CALCULATE(AVERAGE(Deliveries[LateDays]), KEEPFILTERS(Deliveries[DeliveryStatus] = "Late"))
		formatString: 0.0
		displayFolder: Suppliers
		lineageTag: f11d9883-3434-011a-3912-e063cef94a2a

	measure 'Reliability Score' = IF(NOT ISBLANK([Total Deliveries]), AVERAGE(Suppliers[ReliabilityScore]))
		formatString: 0.00
		displayFolder: Suppliers
		lineageTag: af85dbc4-5d6f-b49a-f46c-04e5f33cf203

	measure 'Late % Color' = VAR p = [Late Delivery %] RETURN SWITCH(TRUE(), ISBLANK(p), BLANK(), p >= 0.5, "#C84D4D", p >= 0.4, "#E5A33D", "#25856A")
		displayFolder: Formatting
		lineageTag: b5f371bc-f5ca-164a-5205-3c1ce3db26fe

	column POID
		dataType: string
		lineageTag: 3142c8bf-0236-7695-9232-71d94cb3fd60
		summarizeBy: none
		sourceColumn: POID

		annotation SummarizationSetBy = Automatic

	column SupplierID
		dataType: string
		lineageTag: 6d719e3c-d1c9-0b5e-5a48-24193cabb999
		summarizeBy: none
