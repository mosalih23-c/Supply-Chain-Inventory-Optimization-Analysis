	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderPath & "products_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"ProductID", type text}, {"ProductName", type text}, {"Category", type text}, {"SupplierID", type text}, {"UnitCost", type number}, {"UnitPrice", type number}, {"MinOrderQty", Int64.Type}, {"TargetStockDays", Int64.Type}, {"UnitMargin", type number}, {"MarginPct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

